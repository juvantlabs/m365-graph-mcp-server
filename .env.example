# M365 Graph MCP Server — environment variables.
#
# Copy this file to `.env.local` and fill in the values for your tenant.
# `.env.local` is gitignored. Never commit real credentials.
#
# Each adopter creates their own app registration in Microsoft Entra
# (azure portal → Identity → App registrations) and uses their own
# tenant's values. The MCP server is tenant-agnostic: it reads these
# at startup and authenticates as whatever app you've registered.
#
# See README.md § Local development for the full Entra setup flow.

# Microsoft Entra tenant ID (UUID), or `common` / `organizations` /
# `consumers` for multi-tenant flows. Validated at startup.
M365_TENANT_ID=<your tenant UUID>

# Application (client) ID from the Entra app registration "Overview".
M365_CLIENT_ID=<your app registration client ID>

# Client secret VALUE (not Secret ID). Set in Entra → Certificates & secrets.
# Microsoft only shows this once at creation time; treat as a password.
M365_CLIENT_SECRET=<your client secret>

# Optional: log level for diagnostics on stderr (default: info).
MCP_SERVER_LOG_LEVEL=info
